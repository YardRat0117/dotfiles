vim9script

# Line Number
set number
set relativenumber

# Linebreak
set wrap
set linebreak

# Show command
set showcmd

# Indent
set tabstop=4
set shiftwidth=4
set expandtab
set smartindent
set autoindent
set softtabstop=0

# Search
set ignorecase
set smartcase
set incsearch
set hlsearch

# Encoding
set encoding=utf-8
set fileencodings=utf-8,gbk,latin1
set termencoding=utf-8

# Window Spliting
set splitbelow
set splitright

# Syntax
syntax enable

# Conceal
set conceallevel=2
set concealcursor=

# Cursor hightlight
set cursorcolumn
set cursorline
